{
  "name": "dice-3d-react",
  "version": "0.1.0",
  "description": "React adapter for dice-3d: a <D20View> component.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "dice",
    "d20",
    "react",
    "webgl2",
    "3d"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "dice-3d": "^0.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichalZaawada/dice-3d.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/MichalZaawada/dice-3d#readme",
  "bugs": {
    "url": "https://github.com/MichalZaawada/dice-3d/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
